# =============================================================================
# VPN Script — LIVE EXAMPLE: vps.stanlleylocke.dev (AWS EC2 us-east-1)
# =============================================================================
# Instance : i-03c76f90fe4f9adc0 (proxylockes)
# Type     : t2.small
# Public   : 3.87.53.252
# Private  : 172.31.83.90
# DNS      : vps.stanlleylocke.dev → 3.87.53.252 (Cloudflare DNS only / grey cloud)
#
# BEFORE INSTALL ON EC2:
#   1. AWS Security Group — open ports 22, 80, 443, 8443, 8880, 1194, 5300/udp
#   2. Copy this file:  cp examples/vps.stanlleylocke.dev.env /root/vpn_script.env
#   3. Add Cloudflare API + Telegram tokens below (optional)
#   4. Run install (see bottom)
# =============================================================================

# ── Repository ───────────────────────────────────────────────────────────────
VPN_GITHUB_USER="stanlley-locke"
VPN_REPO_NAME="vpn_script"
VPN_REPO_BRANCH="main"

# ── License & notifications ──────────────────────────────────────────────────
LICENSE_CHECK="0"
INSTALL_NOTIFY="0"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

VPN_SCRIPT_NAME="VPN Script"
VPN_AUTHOR="stanlley-locke"
SUPPORT_TELEGRAM="@stanlley-locke"

# ── VPS / AWS EC2 ───────────────────────────────────────────────────────────
VPS_PUBLIC_IP="3.87.53.252"
VPS_PRIVATE_IP="172.31.83.90"
VPS_PROVIDER="aws-ec2"
VPS_REGION="us-east-1"
VPS_INSTANCE_ID="i-03c76f90fe4f9adc0"
VPS_INSTANCE_TYPE="t2.small"
VPS_SSH_KEY_NAME="proxylockes"
VPS_PUBLIC_DNS="ec2-3-87-53-252.compute-1.amazonaws.com"

# ── Domain & DNS ─────────────────────────────────────────────────────────────
VPN_DOMAIN="vps.stanlleylocke.dev"
CF_ROOT_DOMAIN="stanlleylocke.dev"
CF_DOMAIN="vps.stanlleylocke.dev"
# Grey cloud (DNS only) — traffic goes direct to EC2; Let's Encrypt on origin
CF_DNS_PROXIED="0"

# ── Cloudflare API (fill from dash.cloudflare.com → My Profile → API Tokens) ─
# Needed for: cf-setup, optional SSL automation, future orange-cloud switch
CF_EMAIL=""
CF_API_KEY=""
# CF_API_TOKEN=""

# DNS records (reference — already set in Cloudflare):
#   vps.stanlleylocke.dev  A  3.87.53.252  DNS only
#   vps                    A  3.87.53.252  DNS only  → vps.stanlleylocke.dev
CF_SSL_MODE="full"

# ── SNI / paths (defaults work for direct DNS) ───────────────────────────────
SNI_FRONTING="vps.stanlleylocke.dev"
HTTP_APP_PREFIX=""
PATH_VLESS="/vless"
PATH_VMESS="/vmess"
PATH_TROJAN="/trojan-ws"
PATH_SS="/ss-ws"
PATH_SSH="/"

# ── Routing ──────────────────────────────────────────────────────────────────
ROUTING_PROFILE="global"

# ── SSH ──────────────────────────────────────────────────────────────────────
SSH_WS_PORT="10015"
SSH_DROPBEAR_PORT="109"
SSH_OPENSSH_PORT="22"

# ── Subscription ─────────────────────────────────────────────────────────────
SUBSCRIPTION_TOKEN=""
SUBSCRIPTION_PORT="8099"
# After install: https://vps.stanlleylocke.dev/sub/<token>

# ── REALITY ──────────────────────────────────────────────────────────────────
REALITY_PORT="8443"
REALITY_DEST="www.microsoft.com:443"
REALITY_SNI="www.microsoft.com"
# Client link uses host vps.stanlleylocke.dev:8443 (direct — not via CF proxy)

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Set CF_TUNNEL_ENABLED=1 + run menu 33 if you later want to hide origin IP
CF_TUNNEL_NAME="proxylockes-vps"
CF_TUNNEL_ENABLED="0"

# ── Decoy ────────────────────────────────────────────────────────────────────
DECOY_SITE_TITLE="Welcome"
DECOY_SITE_ENABLED="1"

# ── HTTP Custom (Wi-Fi / direct — no carrier zero-rate on AWS) ───────────────
HTTPC_DEFAULT_PROFILE="profile-v5-production-ssh"

# =============================================================================
# INSTALL COMMANDS (run on EC2 as root)
# =============================================================================
#
# ssh -i proxylockes.pem ubuntu@3.87.53.252
# sudo -i
#
# apt update -y && apt install -y wget curl git
# git clone https://github.com/stanlley-locke/vpn_script.git /root/vpn_script
# cp /root/vpn_script/examples/vps.stanlleylocke.dev.env /root/vpn_script.env
# nano /root/vpn_script.env   # add CF_EMAIL, CF_API_KEY, bot token if needed
#
# cd /root/vpn_script
# set -a && source /root/vpn_script.env && set +a
# ./genz.sh
#
# Or one-liner (downloads latest from GitHub):
# wget -qO /root/vpn_script.env https://raw.githubusercontent.com/stanlley-locke/vpn_script/main/examples/vps.stanlleylocke.dev.env
# set -a && source /root/vpn_script.env && set +a
# curl -fsSL https://raw.githubusercontent.com/stanlley-locke/vpn_script/main/install.sh | bash
#
# AFTER REBOOT:
#   menu
#   sub-manage url          → subscription for Hiddify/Sing-box
#   menu → 31 REALITY       → optional
#   health-check
#
# OPTIONAL — switch Cloudflare to proxied (orange cloud) later:
#   1. Cloudflare DNS → proxy ON for vps.stanlleylocke.dev
#   2. menu → 26 CF SETUP
#   3. menu → 30 RELOAD STACK
# =============================================================================

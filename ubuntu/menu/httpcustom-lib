#!/bin/bash
# Interactive HTTP Custom payload library — stanlley-locke/vpn_script
[ -f /usr/local/lib/vpn_script/common.sh ] && source /usr/local/lib/vpn_script/common.sh
source /usr/local/lib/vpn_script/httpcustom.sh 2>/dev/null || true

grenbo="\e[92;1m"; NC='\e[0m'; Y="\033[1;33m"
domain=$(cat /etc/xray/domain 2>/dev/null || echo "unknown")

clear
echo -e "${Y}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "   HTTP Custom Library — stanlley-locke"
echo -e "   Domain: ${domain}"
echo -e "${Y}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo "  1) List payloads (all)"
echo "  2) List payloads by category"
echo "  3) List SNI hosts"
echo "  4) List proxies"
echo "  5) List v5 profiles"
echo "  6) Safaricom zero-rated hosts"
echo "  7) Search library"
echo "  8) Export v5 profile for SSH user"
echo "  9) Show payload details"
echo "  0) Back to menu"
echo ""
read -rp "Select: " opt

case $opt in
1)
    clear; echo -e "${grenbo}Payloads:${NC}"; httpc_list_payloads | column -t -s $'\t'
    ;;
2)
    echo "Categories: cloudflare split connect websocket carrier cdn advanced"
    read -rp "Category: " cat
    clear; httpc_list_payloads "$cat" | column -t -s $'\t'
    ;;
3)
    clear; echo -e "${grenbo}SNI hosts:${NC}"; httpc_list_sni | column -t -s $'\t'
    ;;
4)
    clear; echo -e "${grenbo}Proxies:${NC}"; httpc_list_proxies | column -t -s $'\t'
    ;;
5)
    clear; echo -e "${grenbo}v5 Profiles:${NC}"; httpc_list_profiles | column -t -s $'\t'
    ;;
6)
    clear; echo -e "${grenbo}Safaricom zero-rated:${NC}"; httpc_list_zerorate safaricom_ke
    echo ""; echo -e "${grenbo}General CDN:${NC}"; httpc_list_zerorate general_cdn
    ;;
7)
    read -rp "Search: " q; clear; httpc_search "$q"
    ;;
8)
    echo "Profiles:"; httpc_list_profiles
    read -rp "Profile ID [profile-v5-production-ssh]: " pid
    pid=${pid:-profile-v5-production-ssh}
    read -rp "SSH user: " u
    read -rsp "SSH pass: " p; echo ""
    httpc-export-v5 "$pid" "$u" "$p"
    ;;
9)
    read -rp "Payload ID: " pid
    clear
    httpc_get_entry payload "$pid" | jq .
    echo ""; echo "Payload string:"; httpc_get_payload "$pid"
    ;;
*)
    menu; exit 0
    ;;
esac

echo ""
read -n1 -s -r -p "Press Enter..."; httpcustom-lib

# =============================================================================
# VPN Script — Environment Configuration (EXAMPLE TEMPLATE)
# =============================================================================
# Copy to your VPS before install:
#   cp .env.example /root/vpn_script.env
#   nano /root/vpn_script.env    # fill secrets, then install
#
# Install with env (non-interactive domain):
#   curl -fsSL .../install.sh | bash
#   — or —
#   export $(grep -v '^#' /root/vpn_script.env | xargs) && ./genz.sh
#
# NEVER commit /root/vpn_script.env — it may contain API keys and bot tokens.
# =============================================================================

# ── Repository ───────────────────────────────────────────────────────────────
VPN_GITHUB_USER="stanlley-locke"
VPN_REPO_NAME="vpn_script"
VPN_REPO_BRANCH="main"
# VPN_REPO="https://raw.githubusercontent.com/stanlley-locke/vpn_script/main"

# ── License & notifications ──────────────────────────────────────────────────
LICENSE_CHECK="0"
INSTALL_NOTIFY="0"
# INSTALL_NOTIFY="1"
# TELEGRAM_BOT_TOKEN="123456789:AA..."
# TELEGRAM_CHAT_ID="your_telegram_user_id"

VPN_SCRIPT_NAME="VPN Script"
VPN_AUTHOR="stanlley-locke"
SUPPORT_TELEGRAM="@stanlley-locke"

# ── VPS / instance (fill for your server) ────────────────────────────────────
VPS_PUBLIC_IP=""
VPS_PRIVATE_IP=""
VPS_PROVIDER="aws-ec2"
VPS_REGION="us-east-1"
VPS_INSTANCE_ID=""
VPS_INSTANCE_TYPE="t2.small"
VPS_SSH_KEY_NAME=""

# ── Domain & DNS (required for install) ──────────────────────────────────────
# Set VPN_DOMAIN to skip the interactive domain prompt during genz.sh
VPN_DOMAIN=""
# Root zone on Cloudflare (for API / tunnel)
CF_ROOT_DOMAIN=""
# Proxied (orange cloud) = 1 | DNS only (grey cloud) = 0
CF_DNS_PROXIED="0"

# ── Cloudflare API (optional — menu → 26 CF SETUP) ───────────────────────────
CF_EMAIL=""
CF_API_KEY=""
# Or Cloudflare API Token (preferred):
# CF_API_TOKEN=""
CF_DOMAIN=""
CF_SSL_MODE="full"
# full = origin cert OK | strict = requires valid origin cert

# ── SNI / HTTP Custom / client-facing TLS ────────────────────────────────────
SNI_FRONTING=""
# Leave empty to use VPN_DOMAIN. Example: SNI_FRONTING="vps.stanlleylocke.dev"

HTTP_APP_PREFIX=""
PATH_VLESS="/vless"
PATH_VMESS="/vmess"
PATH_TROJAN="/trojan-ws"
PATH_SS="/ss-ws"
PATH_SSH="/"
GRPC_VLESS="vless-grpc"
GRPC_VMESS="vmess-grpc"
GRPC_TROJAN="trojan-grpc"
GRPC_SS="ss-grpc"

# ── Xray routing ─────────────────────────────────────────────────────────────
ROUTING_PROFILE="global"
# global | split | adblock | direct

# ── SSH WebSocket ────────────────────────────────────────────────────────────
SSH_WS_PORT="10015"
SSH_DROPBEAR_PORT="109"
SSH_OPENSSH_PORT="22"

# ── Subscription URL (/sub/<token>) ──────────────────────────────────────────
# Auto-generated on install if empty
SUBSCRIPTION_TOKEN=""
SUBSCRIPTION_PORT="8099"

# ── REALITY inbound ──────────────────────────────────────────────────────────
REALITY_PORT="8443"
REALITY_DEST="www.microsoft.com:443"
REALITY_SNI="www.microsoft.com"

# ── Cloudflare Tunnel (optional — hides origin IP) ───────────────────────────
# Skip if using DNS-only A record directly to VPS
CF_TUNNEL_NAME=""
CF_TUNNEL_ENABLED="0"

# ── Decoy site (camouflage) ──────────────────────────────────────────────────
DECOY_SITE_TITLE="Welcome"
DECOY_SITE_ENABLED="1"

# ── Install behaviour ────────────────────────────────────────────────────────
# Pre-set root password (optional — otherwise random saved to /root/.default-pass)
# ROOT_PASSWORD=""

# Skip install confirmation (use with caution)
# VPN_AUTO_INSTALL="1"

# ── HTTP Custom default profile (for exports) ────────────────────────────────
HTTPC_DEFAULT_PROFILE="profile-v5-production-ssh"
# Carrier examples:
# HTTPC_DEFAULT_PROFILE="profile-v5-safaricom-ssh"
# HTTPC_DEFAULT_PROFILE="profile-v5-airtel-ng-ssh"

# ── AWS Security Group reminder (open inbound) ───────────────────────────────
# 22/tcp   SSH admin
# 80/tcp   HTTP / ACME / WS fallback
# 443/tcp  HTTPS HAProxy (main)
# 8443/tcp REALITY
# 8880/tcp SSH alt
# 1194/tcp OpenVPN
# 5300/udp SlowDNS
